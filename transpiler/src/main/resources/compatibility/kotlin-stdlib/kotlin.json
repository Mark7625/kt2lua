{
  "library": "kotlin-stdlib",
  "kotlinVersion": "2.3.0",
  "package": "kotlin",
  "documentation": "Top-level functions, scope functions, and kotlin.Result — everything declared directly in the `kotlin` package (not `kotlin.collections`/`kotlin.sequences`, which have their own manifests, and not `kotlin.math`/`kotlin.text`/`kotlin.ranges`, which have theirs). Audited directly against Emitter.kt's emitCall/emitMethodCallTarget dispatch, not assumed from memory.",
  "declarations": [
    {"id": "kotlin.TODO()", "name": "TODO", "kind": "function", "status": "unsupported", "limitations": ["No dedicated codegen — falls through to a literal call to an undefined Lua global TODO(), failing at runtime with 'attempt to call a nil value' instead of raising NotImplementedError"]},
    {"id": "kotlin.error(Any)", "name": "error", "kind": "function", "status": "partial", "implementation": "Emitter.emitCall", "limitations": ["No dedicated codegen — happens to work by passing through to Lua's own real error(message) global, for the common single-string-argument case; doesn't construct/throw an IllegalStateException the way real Kotlin error() does"]},
    {"id": "kotlin.require(Boolean)", "name": "require", "kind": "function", "status": "unsupported", "limitations": ["Falls through to a literal call to Lua's require(), which is the MODULE LOADER (this transpiler's own module system emits real require(\"...\") calls for imports) — require(condition) passes a boolean where require() expects a module-name string, failing at runtime with \"bad argument #1 to 'require'\". A genuine name collision, not just a gap."]},
    {"id": "kotlin.check(Boolean)", "name": "check", "kind": "function", "status": "unsupported", "limitations": ["No dedicated codegen and no Lua global named check — compiles to a call to an undefined global, fails at runtime"]},
    {"id": "kotlin.requireNotNull(T)", "name": "requireNotNull", "kind": "function", "status": "unsupported", "limitations": ["No dedicated codegen and no matching Lua global — compiles to a call to an undefined global, fails at runtime"]},
    {"id": "kotlin.checkNotNull(T)", "name": "checkNotNull", "kind": "function", "status": "unsupported", "limitations": ["Same as requireNotNull() — no dedicated codegen, no matching Lua global"]},
    {"id": "kotlin.repeat(Int, (Int) -> Unit)", "name": "repeat", "kind": "function", "status": "unsupported", "limitations": ["repeat is a Lua KEYWORD (repeat ... until), so falling through to the literal-passthrough fallback produces repeat(n, function() ... end) — a Lua SYNTAX ERROR, not just a wrong value. Worse than a plain gap."]},
    {"id": "kotlin.assert(Boolean)", "name": "assert", "kind": "function", "status": "partial", "implementation": "Emitter.emitCall", "limitations": ["The simple 1-arg form happens to work via Lua's own real assert(v) global; the lazy-message trailing-lambda form assert(cond) { \"msg\" } breaks — the lambda value is passed as assert's message argument without ever being invoked/stringified"]},
    {"id": "kotlin.lazy(() -> T)", "name": "lazy", "kind": "function", "status": "unsupported", "limitations": ["No dedicated codegen; `by` property-delegation syntax itself isn't lexed/parsed at all, so `val x by lazy { ... }` is a parse-time failure, not just unsupported codegen"]},
    {"id": "kotlin.runCatching(() -> R)", "name": "runCatching", "kind": "function", "status": "partial", "implementation": "Emitter.emitCall, ResultRuntime.__runCatching", "limitations": ["Only the single-lambda-argument call form is recognized; Result<T> isn't a real tracked generic type, just the fixed kotlin.Result pseudo-class"]},
    {"id": "kotlin.Result.onSuccess((T) -> Unit)", "name": "onSuccess", "kind": "function", "receiver": "Result<T>", "status": "partial", "implementation": "ResultRuntime.__resultOnSuccess"},
    {"id": "kotlin.Result.onFailure((Throwable) -> Unit)", "name": "onFailure", "kind": "function", "receiver": "Result<T>", "status": "partial", "implementation": "ResultRuntime.__resultOnFailure"},
    {"id": "kotlin.Result.getOrNull()", "name": "getOrNull", "kind": "function", "receiver": "Result<T>", "status": "partial", "implementation": "ResultRuntime.__resultGetOrNull"},
    {"id": "kotlin.Result.isSuccess", "name": "isSuccess", "kind": "property", "receiver": "Result<T>", "status": "partial", "implementation": "Emitter.emitPropertyAccess", "limitations": ["Works via plain field access against the runtime table ResultRuntime's __runCatching builds (which does have an isSuccess field) rather than any dedicated property binding"]},
    {"id": "kotlin.Result.isFailure", "name": "isFailure", "kind": "property", "receiver": "Result<T>", "status": "partial", "implementation": "Emitter.emitPropertyAccess", "limitations": ["Same plain-field-access caveat as isSuccess"]},
    {"id": "kotlin.Result.getOrDefault(T)", "name": "getOrDefault", "kind": "function", "receiver": "Result<T>", "status": "unsupported", "limitations": ["No dedicated codegen for this overload — only onSuccess/onFailure/getOrNull are routed to a runtime helper"]},
    {"id": "kotlin.Result.getOrElse((Throwable) -> T)", "name": "getOrElse", "kind": "function", "receiver": "Result<T>", "status": "unsupported"},
    {"id": "kotlin.run(() -> R)", "name": "run", "kind": "function", "status": "supported", "implementation": "Emitter.emitCall", "documentation": "Top-level, no-receiver form: `run { ... }` — a plain IIFE call, no runtime helper needed"},
    {"id": "kotlin.T.run(T.() -> R)", "name": "run", "kind": "extension", "receiver": "T", "status": "supported", "implementation": "Emitter.emitMethodCallTarget", "documentation": "Receiver form: `x.run { ... }` — binds the implicit receiver the same way `.apply` does"},
    {"id": "kotlin.T.let((T) -> R)", "name": "let", "kind": "extension", "receiver": "T", "status": "partial", "implementation": "Emitter.emitMethodCallTarget", "limitations": ["Only the single-lambda-argument call form is recognized; a user class defining its own method named `let` correctly takes priority over this built-in"]},
    {"id": "kotlin.T.also((T) -> Unit)", "name": "also", "kind": "extension", "receiver": "T", "status": "partial", "implementation": "Emitter.emitMethodCallTarget", "limitations": ["Same single-argument-only caveat as let()"]},
    {"id": "kotlin.T.apply(T.() -> Unit)", "name": "apply", "kind": "extension", "receiver": "T", "status": "partial", "implementation": "Emitter.emitMethodCallTarget", "limitations": ["Same single-argument-only caveat as let()"]},
    {"id": "kotlin.T.takeIf((T) -> Boolean)", "name": "takeIf", "kind": "extension", "receiver": "T", "status": "partial", "implementation": "Emitter.emitMethodCallTarget, __takeIf runtime helper", "limitations": ["Same single-argument-only caveat as let()"]},
    {"id": "kotlin.T.takeUnless((T) -> Boolean)", "name": "takeUnless", "kind": "extension", "receiver": "T", "status": "partial", "implementation": "Emitter.emitMethodCallTarget, __takeIf runtime helper", "limitations": ["Same single-argument-only caveat as let()"]},
    {"id": "kotlin.with(T, T.() -> R)", "name": "with", "kind": "function", "status": "partial", "implementation": "Emitter.emitCall", "limitations": ["Special-cased as a literal top-level 2-argument call (receiver, lambda) rather than a general dispatch; only recognized when written literally as with(x) { ... }"]},

    {"id": "kotlin.Int", "name": "Int", "kind": "type", "status": "supported", "implementation": "TypeName.INT", "documentation": "Lua's single number type underneath; Int/Int division truncates toward zero via a generated __intdiv helper to match Kotlin semantics"},
    {"id": "kotlin.Double", "name": "Double", "kind": "type", "status": "supported", "implementation": "TypeName.DOUBLE"},
    {"id": "kotlin.String", "name": "String", "kind": "type", "status": "supported", "implementation": "TypeName.STRING"},
    {"id": "kotlin.Boolean", "name": "Boolean", "kind": "type", "status": "supported", "implementation": "TypeName.BOOLEAN"},
    {"id": "kotlin.Unit", "name": "Unit", "kind": "type", "status": "supported", "implementation": "TypeName.UNIT"},
    {"id": "kotlin.Any", "name": "Any", "kind": "type", "status": "supported", "implementation": "TypeName.ANY", "documentation": "Also the fallback every unrecognized type name normalizes to"},
    {"id": "kotlin.Long", "name": "Long", "kind": "type", "status": "partial", "implementation": "Ast.normalizeType", "limitations": ["Collapses to the same TypeName.INT as Int — no distinct 64-bit semantics, no overflow emulation; Lua 5.1 numbers are doubles underneath regardless"]},
    {"id": "kotlin.Short", "name": "Short", "kind": "type", "status": "partial", "implementation": "Ast.normalizeType", "limitations": ["Collapses to TypeName.INT, same as Long"]},
    {"id": "kotlin.Byte", "name": "Byte", "kind": "type", "status": "partial", "implementation": "Ast.normalizeType", "limitations": ["Collapses to TypeName.INT, same as Long — no 8-bit wraparound"]},
    {"id": "kotlin.Float", "name": "Float", "kind": "type", "status": "partial", "implementation": "Ast.normalizeType", "limitations": ["Collapses to TypeName.DOUBLE — no distinct 32-bit precision"]},
    {"id": "kotlin.Char", "name": "Char", "kind": "type", "status": "unsupported", "limitations": ["No Char type exists anywhere in this subset — no single-quote character literal lexing, no distinct Char representation; character-like values go through single-character String values instead (e.g. kotlin.text.String.first()/last())"]},
    {"id": "kotlin.Nothing", "name": "Nothing", "kind": "type", "status": "unsupported", "limitations": ["Not a distinct type — collapses to Any like any other unrecognized name; no special never-returns typing"]},
    {"id": "kotlin.Any.toString()", "name": "toString", "kind": "function", "receiver": "Any", "status": "partial", "implementation": "Emitter.formatForToString", "limitations": ["Works correctly as a standalone call (tostring(...), with List/Set/Map bracket formatting) — the gap is that its STRING return type isn't tracked by the simplistic binary-expression type inferencer, so acc + x.toString() inside something like fold's accumulator (declared ANY, not STRING) can resolve the + to numeric arithmetic instead of string concatenation and fail at runtime with 'attempt to perform arithmetic on a string value'.", "A second, separate gap found the same way: the List/Set/Map bracket formatting only fires when the value being printed is statically tracked as a List/Set/Map at the print call site. A List value fetched dynamically out of another collection (e.g. println(xs.groupBy { ... }[0]), or a chunked() sub-list) isn't tracked that way, so it prints as a raw table: 0x... address instead of [1, 2, 3] — the underlying data is still correct (confirmed via .size and real iteration), only the print representation degrades. Confirmed via a real interpreter run, not just reasoning about the code."]},
    {"id": "kotlin.Array(T)", "name": "Array", "kind": "type", "status": "unsupported", "limitations": ["No Array<T>/arrayOf(...) support at all — not even aliased onto List the way MutableList/ArrayList/HashSet/etc. are"]},
    {"id": "kotlin.T?", "name": "T?", "kind": "language-feature", "status": "partial", "implementation": "Parser.kt (trailing '?' on a type is parsed and discarded)", "limitations": ["Purely cosmetic — there is no nullable-vs-non-null static type tracking anywhere; null-safety is handled only via the explicit runtime operators ?./?:/!!/as?, never via inferred nullability"]},
    {"id": "kotlin.genericTypeArguments", "name": "genericTypeArguments", "kind": "language-feature", "status": "partial", "implementation": "Parser.skipGenericArgs", "limitations": ["<T> type arguments on a type name or a call site are parsed and immediately discarded — no generics are tracked anywhere, so e.g. emptyList<Module>() and emptyList<Int>() compile identically"]},
    {"id": "kotlin.as(Any)", "name": "as", "kind": "language-feature", "status": "unsupported", "implementation": "Parser.kt", "limitations": ["Parsed and fully discarded — 'Lua is dynamically typed and needs no cast' — so an incorrect cast never throws a ClassCastException the way real Kotlin does"]},
    {"id": "kotlin.as?(Any)", "name": "as?", "kind": "language-feature", "status": "unsupported", "implementation": "Parser.kt", "limitations": ["Same code path as as — the trailing ? is only tolerated syntactically. There is no runtime type check and no null-on-failure behavior; (x as? String) compiles to just x unchanged regardless of its real runtime type. A correctness gap, not merely a missing feature."]},
