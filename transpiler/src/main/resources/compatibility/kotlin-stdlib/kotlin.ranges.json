  "library": "kotlin-stdlib",
  "kotlinVersion": "2.3.0",
  "package": "kotlin.ranges",
  "documentation": "There is no general Range type/value at all — no RangeExpr AST node, nothing stored/returned/passed. The .. / until / step tokens are recognized in exactly two grammar positions: a numeric for-loop header, and a when-branch 'in a..b' condition. Outside those two positions, a range expression doesn't parse.",
  "declarations": [
    {"id": "kotlin.ranges.Int.rangeTo(Int)", "name": "rangeTo", "kind": "operator", "receiver": "Int", "status": "partial", "implementation": "ForFeature.kt, WhenFeature.kt/WhenEmitter.kt", "limitations": ["The .. operator only parses inside a for-loop header (for (i in a..b)) or a when-branch condition (in a..b) — it is not a general binary operator, so a..b can't be stored in a variable, returned, or passed as a value"]},
    {"id": "kotlin.ranges.until(Int, Int)", "name": "until", "kind": "function", "status": "partial", "implementation": "ForFeature.kt, WhenFeature.kt", "limitations": ["Same two-position-only restriction as rangeTo (..)"]},
    {"id": "kotlin.ranges.downTo(Int, Int)", "name": "downTo", "kind": "function", "status": "unsupported", "limitations": ["Not a lexer token, not a keyword, nowhere in the codebase — for (i in 10 downTo 1) fails to parse entirely (the parser expects '..'/'until'/')' after the start expression)"]},
    {"id": "kotlin.ranges.IntProgression.step(Int)", "name": "step", "kind": "function", "receiver": "IntProgression", "status": "partial", "implementation": "ForFeature.kt", "limitations": ["Only recognized directly inside a for-loop header (for (i in a..b step s)) — not a general operation on a stored range value, since no stored range value exists"]},
    {"id": "kotlin.ranges.IntRange", "name": "IntRange", "kind": "type", "status": "unsupported", "limitations": ["No IntRange type exists as a value — a range only ever exists transiently as for-loop or when-condition syntax, never as something with its own identity, methods (first/last/contains as a value), or storage"]},
    {"id": "kotlin.ranges.ClosedRange.contains(T)", "name": "contains", "kind": "function", "receiver": "ClosedRange<T>", "status": "partial", "implementation": "WhenFeature.kt, WhenEmitter.kt", "limitations": ["'x in a..b' only works inside a when branch, lowered to an explicit (x >= a and x <= b) bounds check — not a general-purpose range-contains usable outside when"]},
