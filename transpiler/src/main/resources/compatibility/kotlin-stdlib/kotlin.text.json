{
  "library": "kotlin-stdlib",
  "kotlinVersion": "2.3.0",
  "package": "kotlin.text",
  "documentation": "String is registered as a native external class with exactly one known property (length) — almost everything else on String has no dedicated codegen. Audited against Emitter.kt's String-specific branches plus the generic NUMERIC_CAST_NAMES/emitIndex paths that silently (and sometimes wrongly) apply to a String receiver too.",
  "declarations": [
    {"id": "kotlin.text.String.length", "name": "length", "kind": "property", "receiver": "String", "status": "supported", "implementation": "Emitter.lengthAccess", "documentation": "Lua's # length operator — same mechanism as List/Set/Map .size"},
    {"id": "kotlin.text.String.get(Int)", "name": "get", "kind": "function", "receiver": "String", "status": "unsupported", "limitations": ["Lua strings aren't indexable with [] (a string's metatable routes __index to the string library, not characters) — s[0] silently compiles to the List-style s[1] shift and returns nil instead of erroring or returning a character. A real correctness gap, not just a missing feature."]},
    {"id": "kotlin.text.String.first()", "name": "first", "kind": "extension", "receiver": "String", "status": "supported", "implementation": "Emitter.emitMethodCallTarget", "documentation": "string.sub(s, 1, 1)"},
    {"id": "kotlin.text.String.last()", "name": "last", "kind": "extension", "receiver": "String", "status": "supported", "implementation": "Emitter.emitMethodCallTarget", "documentation": "string.sub(s, -1, -1)"},
    {"id": "kotlin.text.String.contains(CharSequence)", "name": "contains", "kind": "function", "receiver": "String", "status": "supported", "implementation": "Emitter.emitContains", "documentation": "string.find(s, x, 1, true) — plain literal substring search, also reachable via the general `x in s` infix operator"},
    {"id": "kotlin.text.String.hashCode()", "name": "hashCode", "kind": "function", "receiver": "String", "status": "partial", "implementation": "Emitter.emitHashCodeExpr", "limitations": ["A hand-written FNV/Java-style string hash loop — produces a stable, collision-safe-enough value for this transpiler's own internal use, but does NOT match the real JVM String.hashCode() integer value"]},
    {"id": "kotlin.text.String.toInt()", "name": "toInt", "kind": "extension", "receiver": "String", "status": "unsupported", "limitations": ["No-op pass-through (the string's own Lua text, unchanged) — relies entirely on Lua's implicit string-to-number coercion in arithmetic contexts; breaks under ==, tostring(), string.format(\"%d\", ...), or anything that cares the value is a real Lua number and not a string"]},
    {"id": "kotlin.text.String.toDouble()", "name": "toDouble", "kind": "extension", "receiver": "String", "status": "unsupported", "limitations": ["Same no-op pass-through caveat as toInt()"]},
    {"id": "kotlin.text.String.toFloat()", "name": "toFloat", "kind": "extension", "receiver": "String", "status": "unsupported", "limitations": ["Same no-op pass-through caveat as toInt()"]},
